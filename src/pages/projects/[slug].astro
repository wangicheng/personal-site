---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPath } from '../../lib/url';
import { renderLatex } from '../../lib/latex';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map(project => ({
		params: { slug: project.id },
		props: { project }
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={`${data.title} - Project Details`} description={data.summary}>
	<article class="container section">
		<div class="back-nav">
			<a href={getPath('/projects')} class="back-link mono">
				<Icon name="arrow-left" size={16} />
				Back to projects
			</a>
		</div>

		<header class="project-header">
			{
				data.image && (
					<figure class="project-hero-shot">
						<Image
							src={data.image}
							alt={data.title}
							loading="eager"
							decoding="async"
						/>
					</figure>
				)
			}

			<span class="eyebrow mono">Featured Project · {data.period}</span>

			<h1 class="project-title">{data.title}</h1>

			<p class="project-role-text mono">
				{data.role}
			</p>

			<p class="project-lead" set:html={renderLatex(data.summary)} />

			<div class="project-meta-box glow-card">
				<div class="meta-section">
					<h3 class="meta-head mono">Tech Stack</h3>
					<ul class="tag-row">
						{data.tags.map(t => <li class="tag">{t}</li>)}
					</ul>
				</div>

				{
					data.highlights.length > 0 && (
						<div class="meta-section">
							<h3 class="meta-head mono">Key Highlights</h3>
							<ul class="highlights-list">
								{data.highlights.map(h => (
									<li set:html={renderLatex(h)} />
								))}
							</ul>
						</div>
					)
				}

				<div class="meta-actions">
					{
						data.githubUrl && (
							<a
								class="btn-primary"
								href={data.githubUrl}
								target="_blank"
								rel="noreferrer"
							>
								<Icon name="github" size={17} />
								View on GitHub
								<Icon name="arrow-up-right" size={14} />
							</a>
						)
					}
					{
						data.demoUrl && (
							<a
								class="btn-ghost"
								href={data.demoUrl}
								target="_blank"
								rel="noreferrer"
							>
								Live Demo
								<Icon name="arrow-up-right" size={14} />
							</a>
						)
					}
				</div>
			</div>
		</header>

		<div class="project-content markdown-body">
			<Content />
		</div>

		<footer class="project-footer">
			<div class="footer-actions">
				<a href={getPath('/projects')} class="btn-ghost">
					<Icon name="arrow-left" size={16} />
					Back to projects
				</a>
				<a href={getPath('/experience')} class="btn-primary">
					View experience
					<Icon name="arrow-right" size={16} />
				</a>
			</div>
		</footer>
	</article>
</Base>

<style>
	.section {
		padding-block: 6.5rem 5rem;
		max-width: 54rem;
	}
	.back-nav {
		margin-bottom: 2rem;
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-size: 0.85rem;
		transition: color 0.16s ease;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.project-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.project-title {
		font-size: clamp(2rem, 5.5vw, 3.4rem);
		line-height: 1.05;
	}
	.project-role-text {
		color: var(--accent);
		font-size: 0.9rem;
		letter-spacing: 0.04em;
	}
	.project-lead {
		font-size: 1.15rem;
		color: var(--fg);
		line-height: 1.65;
		margin-top: 0.2rem;
	}
	.project-meta-box {
		margin-top: 1.5rem;
		padding: 1.8rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.meta-head {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 0.7rem;
	}
	.highlights-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.highlights-list li {
		position: relative;
		padding-left: 1.4rem;
		color: var(--fg);
		font-size: 0.96rem;
		line-height: 1.6;
	}
	.highlights-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}
	.meta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--line);
	}
	.project-hero-shot {
		margin: 0 0 0.8rem;
		border-radius: 16px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 60%, transparent);
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.28);
		overflow: hidden;
		line-height: 0;
	}
	.project-hero-shot img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Markdown 內容樣式 */
	.project-content {
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--line);
	}
	.markdown-body :global(h2) {
		font-size: 1.65rem;
		margin-top: 2.8rem;
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--line);
		color: var(--fg);
	}
	.markdown-body :global(h3) {
		font-size: 1.25rem;
		margin-top: 2rem;
		margin-bottom: 0.8rem;
		color: var(--accent);
	}
	.markdown-body :global(h4) {
		font-size: 1.05rem;
		margin-top: 1.5rem;
		margin-bottom: 0.6rem;
		color: var(--fg);
	}
	.markdown-body :global(p) {
		color: var(--prose);
		font-size: 1.02rem;
		line-height: 1.8;
		margin-bottom: 1.25rem;
	}
	.markdown-body :global(strong) {
		color: var(--fg);
		font-weight: 600;
	}
	.markdown-body :global(ul) {
		list-style: disc;
		padding-left: 1.4rem;
		margin-bottom: 1.4rem;
		color: var(--prose);
	}
	.markdown-body :global(ol) {
		list-style: decimal;
		padding-left: 1.4rem;
		margin-bottom: 1.4rem;
		color: var(--prose);
	}
	.markdown-body :global(li) {
		margin-bottom: 0.5rem;
		line-height: 1.75;
	}
	.markdown-body :global(code:not(pre *)) {
		padding: 0.15rem 0.4rem;
		border-radius: 6px;
		background: color-mix(in oklab, var(--surface-2) 75%, transparent);
		border: 1px solid var(--line);
		color: var(--accent-2);
		font-family: var(--font-mono);
		font-size: 0.88em;
	}
	.markdown-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin-block: 1.6rem 2.2rem;
		font-size: 0.94rem;
		overflow-x: auto;
		display: block;
	}
	.markdown-body :global(th),
	.markdown-body :global(td) {
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		text-align: left;
	}
	.markdown-body :global(th) {
		background: color-mix(in oklab, var(--surface-2) 65%, transparent);
		color: var(--fg);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}
	.markdown-body :global(td) {
		color: var(--prose);
		background: color-mix(in oklab, var(--surface) 35%, transparent);
	}
	.markdown-body :global(pre) {
		padding: 1.2rem 1.4rem;
		border-radius: 12px;
		border: 1px solid var(--line);
		background: var(--bg-deep) !important;
		overflow-x: auto;
		margin-block: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.88rem;
		line-height: 1.6;
	}
	.markdown-body :global(.katex-display) {
		margin-block: 1.5rem;
		overflow-x: auto;
		overflow-y: hidden;
		padding-block: 0.4rem;
	}
	.markdown-body :global(hr) {
		border: none;
		border-top: 1px solid var(--line);
		margin-block: 2.8rem;
	}
	.markdown-body :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.8rem 1.2rem;
		border-left: 3px solid var(--accent);
		background: color-mix(in oklab, var(--surface) 50%, transparent);
		border-radius: 0 8px 8px 0;
	}
	.markdown-body :global(picture) {
		display: block;
		max-width: 100%;
		margin-block: 1.8rem 0.6rem;
	}
	.markdown-body :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 60%, transparent);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
		margin-block: 1.8rem 0.6rem;
		display: block;
		margin-inline: auto;
	}
	.markdown-body :global(picture img) {
		margin-block: 0;
		background: color-mix(in oklab, var(--surface) 40%, transparent);
		padding: 1.2rem;
	}
	.markdown-body :global(p:has(> em:only-child)),
	.markdown-body :global(figcaption) {
		text-align: center;
		font-size: 0.88rem;
		color: var(--muted);
		margin-top: 0.4rem;
		margin-bottom: 1.8rem;
	}
	.markdown-body :global(p:has(> em:only-child) em) {
		color: var(--muted);
		font-style: normal;
	}

	.project-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
	.footer-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
	}
</style>
